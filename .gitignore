# Python cache and artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
# Jupyter notebook checkpoint files/folders
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# macOS / editor
.DS_Store
.vscode/
.idea/

# Data and model artifacts
*.zip
*.h5
*.hdf5
*.trch
*.ckpt


# Large project directories (keep folder structure only)
/datasets/**
/models/**
!datasets/.gitkeep
!models/.gitkeep

# NIfTI / pickle outputs
*.nii
*.nii.gz
*.pkl

# Logs
*.log

# Training run artifacts (W&B syncs best_model.pt; keep metrics/plots in git if needed)
**/best_model.pt
**/wandb/

# Cursor artifacts
.cursor/
.cursorrules
.cursorignore
.cursorconfig
.cursorhistory
.cursorhistory

# Kubernetes / cluster (never commit credentials)
kubeconfig
*.kubeconfig
**/kube/config

# Local Nautilus overrides (namespace, personal limits)
deploy/nautilus/local/

# Commands
commands.sh
