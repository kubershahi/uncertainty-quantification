# Shell snippets must use LF — CRLF breaks Linux/bash (set: pipefail errors).
*.sh text eol=lf
# Embedded bash in Nautilus manifests must stay LF as well.
deploy/nautilus/**/*.yaml text eol=lf

# Git LFS — binary QC figures and reports
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
